    "@types/jest": "^29.5.0",
    "@types/react": "~18.2.79",
    "@types/react-native": "^0.73.0",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "babel-preset-expo": "~11.0.0",
    "eslint": "^8.50.0",
    "eslint-config-expo": "~7.1.2",
    "jest": "^29.7.0",
    "jest-expo": "^51.0.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
